; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GDVNLauncher"
run/main_scene="uid://5f1ylcxfm58a"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DisplayManager="*res://autoloads/display_manager.gd"
AsyncHTTPClient="*res://autoloads/async_http_client.gd"
CacheManager="*res://autoloads/cache_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=850
window/energy_saving/keep_screen_on=false
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://autoloads/": "blue",
"res://modules/": "teal"
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
